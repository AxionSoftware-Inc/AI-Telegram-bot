# Telegram Bot Token (@BotFather orqali olingan token)
BOT_TOKEN=your_telegram_bot_token_here

# Ollama Server URL (Mahalliy yoki serverdagi manzil)
OLLAMA_URL=http://localhost:11434

# Ishlatilayotgan AI modeli (gemma4-26b:latest, qwen3-8b-local, qwen2.5-1.5b va h.k.)
MODEL_NAME=gemma4-26b:latest

# Spamdan himoya qilish uchun kutish vaqti (soniyada)
COOLDOWN_SECONDS=5
