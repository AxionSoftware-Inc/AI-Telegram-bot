# Telegram Bot Token (@BotFather orqali olingan token)
BOT_TOKEN=your_telegram_bot_token_here

# OpenRouter API Key (Tezkor va arzon cloud AI modellar uchun)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Ollama Server URL (Mahalliy yoki serverdagi manzil, agar lokal model ishlatilsa)
OLLAMA_URL=http://localhost:11434

# Ishlatilayotgan AI modeli (google/gemini-2.5-flash-lite, gemma4-26b:latest va h.k.)
MODEL_NAME=google/gemini-2.5-flash-lite

# Spamdan himoya qilish uchun kutish vaqti (soniyada)
COOLDOWN_SECONDS=5
